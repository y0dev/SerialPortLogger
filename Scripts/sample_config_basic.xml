<?xml version="1.0" encoding="utf-8"?>
<Configuration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Items>
    <Item name="basketball">
      <Modes>
        <Mode name="dribble">
          <KeywordGroups>
            <KeywordGroup>
              <Keywords>
                <Keyword>Dribble Number Test</Keyword>
                <Keyword>Ball Handling</Keyword>
              </Keywords>
              <OutputFile>dribble_data.csv</OutputFile>
            </KeywordGroup>
            <KeywordGroup>
              <Keywords>
                <Keyword>Game Stats</Keyword>
                <Keyword>Performance Metrics</Keyword>
              </Keywords>
              <OutputFile>game_stats.csv</OutputFile>
            </KeywordGroup>
          </KeywordGroups>
        </Mode>
        <Mode name="shooting">
          <KeywordGroups>
            <KeywordGroup>
              <Keywords>
                <Keyword>Shot Attempts</Keyword>
                <Keyword>Field Goals</Keyword>
              </Keywords>
              <OutputFile>shooting_data.csv</OutputFile>
            </KeywordGroup>
          </KeywordGroups>
        </Mode>
      </Modes>
    </Item>
    <Item name="football">
      <Modes>
        <Mode name="defense">
          <KeywordGroups>
            <KeywordGroup>
              <Keywords>
                <Keyword>Defensive Coverages</Keyword>
                <Keyword>Tackle Stats</Keyword>
              </Keywords>
              <OutputFile>defense_data.csv</OutputFile>
            </KeywordGroup>
          </KeywordGroups>
        </Mode>
      </Modes>
    </Item>
  </Items>
  
  <Settings>
    <Theme>Light</Theme>
    <Font>Segoe UI</Font>
    <FontSize>12</FontSize>
  </Settings>
  
  <ComputerConfigs>
    <ComputerConfig name="MainPC">
      <SerialConsoleConfigs>
        <SerialConsoleConfig name="COM1_Logger">
          <Title>Main Serial Logger</Title>
          <ColorScheme>Light Mode</ColorScheme>
          <FontSize>14</FontSize>
        </SerialConsoleConfig>
        <SerialConsoleConfig name="COM2_Monitor">
          <Title>System Monitor</Title>
          <ColorScheme>Dark Mode</ColorScheme>
          <FontSize>12</FontSize>
        </SerialConsoleConfig>
      </SerialConsoleConfigs>
    </ComputerConfig>
    <ComputerConfig name="BackupPC">
      <SerialConsoleConfigs>
        <SerialConsoleConfig name="COM3_Backup">
          <Title>Backup Logger</Title>
          <ColorScheme>Solarized Light</ColorScheme>
          <FontSize>16</FontSize>
        </SerialConsoleConfig>
      </SerialConsoleConfigs>
    </ComputerConfig>
  </ComputerConfigs>
  
  <RecentActivity>
    <Activity ComputerName="MainPC" Type="Serial Logging" SerialPort="COM1" FilesAnalyzed="15" ActivityDateTime="2024-01-15T10:30:00" />
    <Activity ComputerName="BackupPC" Type="File Transfer" IPAddress="192.168.1.100" FilesTransferred="8" ActivityDateTime="2024-01-15T09:15:00" />
  </RecentActivity>
</Configuration>
