<UserControl x:Class="SerialLogAnalyzer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SerialLogAnalyzer.Views"
             xmlns:vm="clr-namespace:SerialLogAnalyzer.ViewModels"
             mc:Ignorable="d"
             x:Name="SettingsControl">


	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/LightTheme.xaml"/>
				<ResourceDictionary Source="../Themes/ButtonStyles.xaml"/>
				<ResourceDictionary Source="../Themes/ComboBoxStyles.xaml"/>
				<ResourceDictionary Source="../Themes/CheckboxStyles.xaml"/>
				<ResourceDictionary Source="../Themes/LabelStyles.xaml"/>
				<ResourceDictionary Source="../Themes/ListviewStyles.xaml"/>
				<ResourceDictionary Source="../Themes/TabItemStyles.xaml"/>
				<ResourceDictionary Source="../Themes/TextboxStyles.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<vm:MainViewModel x:Key="MainViewModel"/>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Row for Title -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Theme -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Font ComboBox -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Font Size ComboBox -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Configuration Management -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Config List -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Config Buttons -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Action Buttons -->
			<RowDefinition Height="Auto"/>
			<!-- Row for Save Button -->
		</Grid.RowDefinitions>

		<!-- Header Label -->
		<TextBlock x:Name="headerLabel" Grid.Row="0" Grid.ColumnSpan="2" Text="Application Settings" FontSize="28" Margin="0,0,0,10"/>

		<!-- Available Font ComboBox -->
		<StackPanel Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Center" Margin="10">
			<TextBlock Text="Light" VerticalAlignment="Center" Margin="5,0"/>
			<ToggleButton x:Name="themeToggleButton" Style="{StaticResource ToggleSwitchStyle}" 
						  IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" Margin="10,0"
						  Click="ToggleButton_Click"/>
			<TextBlock Text="Dark" VerticalAlignment="Center" Margin="5,0"/>
		</StackPanel>

		<!-- Available Font ComboBox -->
		<StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,5">
			<TextBlock Text="Select Font:" VerticalAlignment="Center" Margin="0,0,10,0"/>
			<ComboBox x:Name="fontsComboBox" Width="200" ItemsSource="{Binding AvailableFonts}" 
                      SelectedItem="{Binding SelectedFont}"/>
		</StackPanel>

		<!-- Font Size ComboBox -->
		<StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,5">
			<TextBlock Text="Select Font Size:" VerticalAlignment="Center" Margin="0,0,10,0"/>
			<ComboBox x:Name="fontSizeComboBox" Width="200" ItemsSource="{Binding FontSizes}"
                      SelectedItem="{Binding SelectedFontSize}"/>
		</StackPanel>

		<!-- Configuration Management Section -->
		<TextBlock Grid.Row="5" Text="Configuration Management" FontSize="18" FontWeight="Bold" Margin="0,20,0,10"/>
		
		<!-- Configuration List -->
		<ListView x:Name="configListView" Grid.Row="6" Height="200" Margin="0,5" 
				  ItemsSource="{Binding AvailableConfigs}" 
				  SelectedItem="{Binding SelectedConfig, Mode=TwoWay}">
			<ListView.View>
				<GridView>
					<GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding DisplayName}"/>
					<GridViewColumn Header="Theme" Width="80" DisplayMemberBinding="{Binding Theme}"/>
					<GridViewColumn Header="Computers" Width="80" DisplayMemberBinding="{Binding ComputerCount}"/>
					<GridViewColumn Header="Last Modified" Width="150" DisplayMemberBinding="{Binding LastModified, StringFormat=yyyy-MM-dd HH:mm}"/>
				</GridView>
			</ListView.View>
		</ListView>

		<!-- Configuration Buttons -->
		<StackPanel Orientation="Horizontal" Grid.Row="7" Margin="0,10">
			<Button x:Name="loadConfigButton" Content="Load Config" Style="{StaticResource RoundedButtonStyle}" 
				Width="120" Height="30" Margin="0,0,10,0" Click="LoadConfigButton_Click"/>
			<Button x:Name="newConfigButton" Content="New Config" Style="{StaticResource RoundedButtonStyle}" 
				Width="120" Height="30" Margin="0,0,10,0" Click="NewConfigButton_Click"/>
			<Button x:Name="deleteConfigButton" Content="Delete Config" Style="{StaticResource RoundedButtonStyle}" 
				Width="120" Height="30" Margin="0,0,10,0" Click="DeleteConfigButton_Click"/>
			<Button x:Name="refreshConfigsButton" Content="Refresh" Style="{StaticResource RoundedButtonStyle}" 
				Width="100" Height="30" Click="RefreshConfigsButton_Click"/>
		</StackPanel>

		<!-- Action Buttons -->
		<StackPanel Orientation="Horizontal" Grid.Row="8" Margin="0,20,0,10">
			<Button x:Name="helpButton" Content="Help" Style="{StaticResource RoundedButtonStyle}" 
				Width="100" Height="30" Margin="0,0,10,0" Click="HelpButton_Click"/>
			<Button x:Name="aboutButton" Content="About" Style="{StaticResource RoundedButtonStyle}" 
				Width="100" Height="30" Margin="0,0,10,0" Click="AboutButton_Click"/>
			<Button x:Name="saveButton" Content="Save Settings" Style="{StaticResource RoundedButtonStyle}" 
				Width="120" Height="30" Click="SaveButton_Click"/>
		</StackPanel>
	</Grid>
</UserControl>
