<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Primary and Secondary Colors for Dark Theme - Modern and Consistent -->
	<Color x:Key="PrimaryColor">#111827</Color>
	<Color x:Key="SecondaryColor">#1F2937</Color>
	<Color x:Key="FontColor">#F9FAFB</Color>

	<!-- General Brushes -->
	<SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource PrimaryColor}"/>
	<SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SecondaryColor}"/>
	<SolidColorBrush x:Key="FontBrush" Color="{StaticResource FontColor}"/>
	<SolidColorBrush x:Key="ForegroundBrush" Color="#F9FAFB"/>

	<!-- Toggle Switch Colors - Better Contrast -->
	<SolidColorBrush x:Key="ToggleSwitchBackground" Color="#374151"/>
	<SolidColorBrush x:Key="ToggleSwitchCheckedBackground" Color="#3B82F6"/>
	<SolidColorBrush x:Key="ToggleSwitchBorderColor" Color="#4B5563"/>
	<SolidColorBrush x:Key="ToggleSwitchThumbColor" Color="White"/>
	<SolidColorBrush x:Key="ToggleSwitchDisabledBackground" Color="#1F2937"/>
	<SolidColorBrush x:Key="ToggleSwitchDisabledThumbColor" Color="#6B7280"/>

	<!-- TextBox Colors - Enhanced Visibility -->
	<SolidColorBrush x:Key="TextBoxBaseColor" Color="#374151"/>
	<SolidColorBrush x:Key="TextBoxTextColor" Color="#F9FAFB"/>
	<SolidColorBrush x:Key="TextBoxMouseOverColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="TextBoxFocusedColor" Color="#2563EB"/>
	<SolidColorBrush x:Key="TextBoxDisabledColor" Color="#1F2937"/>
	<SolidColorBrush x:Key="TextBoxDisabledTextColor" Color="#6B7280"/>

	<!-- Button Colors - Modern and Visible -->
	<SolidColorBrush x:Key="ButtonBaseColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="ButtonMouseOverColor" Color="#2563EB"/>
	<SolidColorBrush x:Key="ButtonPressedColor" Color="#1D4ED8"/>
	<SolidColorBrush x:Key="ButtonDisabledColor" Color="#374151"/>
	<SolidColorBrush x:Key="ButtonDisabledTextColor" Color="#6B7280"/>

	<!-- ListView Colors - Better Contrast -->
	<SolidColorBrush x:Key="ListViewBaseColor" Color="#1F2937"/>
	<SolidColorBrush x:Key="ListViewTextColor" Color="#F9FAFB"/>
	<SolidColorBrush x:Key="ListViewItemMouseOverColor" Color="#374151"/>
	<SolidColorBrush x:Key="ListViewItemBaseColor" Color="#1F2937"/>
	<SolidColorBrush x:Key="ListViewItemSelectedColor" Color="#1E40AF"/>
	<SolidColorBrush x:Key="ListViewItemSelectedTextColor" Color="#F9FAFB"/>

	<!-- ComboBox Colors - Enhanced Visibility -->
	<SolidColorBrush x:Key="ComboBoxBaseColor" Color="#374151"/>
	<SolidColorBrush x:Key="ComboBoxTextColor" Color="#F9FAFB"/>
	<SolidColorBrush x:Key="ComboBoxItemMouseOverColor" Color="#4B5563"/>
	<SolidColorBrush x:Key="ComboBoxItemBaseColor" Color="#374151"/>
	<SolidColorBrush x:Key="ComboBoxItemSelectedColor" Color="#1E40AF"/>
	<SolidColorBrush x:Key="ComboBoxItemSelectedTextColor" Color="#F9FAFB"/>

	<!-- Checkbox Colors - Better Visibility -->
	<SolidColorBrush x:Key="CheckboxBorderColor" Color="#6B7280"/>
	<SolidColorBrush x:Key="CheckboxCheckedColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="CheckboxBackgroundColor" Color="#374151"/>
	<SolidColorBrush x:Key="CheckboxHoverBorderColor" Color="#3B82F6"/>

	<!-- TabControl Colors - Modern Look -->
	<SolidColorBrush x:Key="TabControlBackground" Color="#1F2937"/>
	<SolidColorBrush x:Key="TabControlForeground" Color="#F9FAFB"/>
	<SolidColorBrush x:Key="TabControlBorderColor" Color="#374151"/>

	<!-- TabItem Colors - Enhanced Contrast -->
	<SolidColorBrush x:Key="TabItemBackground" Color="#374151"/>
	<SolidColorBrush x:Key="TabItemSelectedBackground" Color="#111827"/>
	<SolidColorBrush x:Key="TabItemHoverBackground" Color="#4B5563"/>
	<SolidColorBrush x:Key="TabItemBorderColor" Color="#6B7280"/>
	<SolidColorBrush x:Key="TabItemSelectedBorderColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="TabItemForeground" Color="#D1D5DB"/>
	<SolidColorBrush x:Key="TabItemHoverForeground" Color="#F3F4F6"/>
	<SolidColorBrush x:Key="TabItemDisabledForeground" Color="#6B7280"/>

	<!-- TabItem Colors -->
	<SolidColorBrush x:Key="MenuButtonStyleForeground" Color="{StaticResource FontColor}"/>
	<SolidColorBrush x:Key="MenuButtonStyleCheckedBackgroundBrush" Color="#1E40AF"/>

	<!-- Define Brushes for ComboBox - Improved Visibility -->
	<SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundBrush" Color="#374151"/>
	<SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrush" Color="#6B7280"/>
	<SolidColorBrush x:Key="ComboBoxArrowFillBrush" Color="#9CA3AF"/>
	<SolidColorBrush x:Key="ComboBoxArrowHoverFillBrush" Color="#3B82F6"/>
	<SolidColorBrush x:Key="ComboBoxArrowPressedFillBrush" Color="#2563EB"/>
	<SolidColorBrush x:Key="ComboBoxTextBoxBackgroundBrush" Color="#374151"/>
	<SolidColorBrush x:Key="ComboBoxTextBoxForegroundBrush" Color="#F9FAFB"/>
	<SolidColorBrush x:Key="DropDownBorderBrush" Color="#6B7280"/>
	<SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#374151"/>
	<SolidColorBrush x:Key="ComboBoxItemHighlightBackgroundBrush" Color="#4B5563"/>
	<SolidColorBrush x:Key="ComboBoxItemDisabledForegroundBrush" Color="#6B7280"/>

	<!-- Additional Modern Colors -->
	<SolidColorBrush x:Key="BorderColor" Color="#374151"/>
	<SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
	<SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
	<SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/>

	<!-- ListView Item Text Color -->
	<SolidColorBrush x:Key="ListViewItemTextColor" Color="{StaticResource ListViewTextColor}"/>

</ResourceDictionary>
