<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Primary and Secondary Colors for Light Theme - Improved Contrast -->
	<Color x:Key="PrimaryColor">#FFFFFF</Color>
	<Color x:Key="SecondaryColor">#F8FAFC</Color>
	<Color x:Key="FontColor">#1F2937</Color>

	<!-- General Brushes -->
	<SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource PrimaryColor}" />
	<SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SecondaryColor}"/>
	<SolidColorBrush x:Key="FontBrush" Color="{StaticResource FontColor}" />
	<SolidColorBrush x:Key="ForegroundBrush" Color="#1F2937"/>

	<!-- Toggle Switch Colors - Better Contrast -->
	<SolidColorBrush x:Key="ToggleSwitchBackground" Color="#E5E7EB"/>
	<SolidColorBrush x:Key="ToggleSwitchCheckedBackground" Color="#3B82F6"/>
	<SolidColorBrush x:Key="ToggleSwitchBorderColor" Color="#D1D5DB"/>
	<SolidColorBrush x:Key="ToggleSwitchThumbColor" Color="White"/>
	<SolidColorBrush x:Key="ToggleSwitchDisabledBackground" Color="#F3F4F6"/>
	<SolidColorBrush x:Key="ToggleSwitchDisabledThumbColor" Color="#9CA3AF"/>

	<!-- TextBox Styles - Enhanced Visibility -->
	<SolidColorBrush x:Key="TextBoxBaseColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="TextBoxTextColor" Color="#1F2937"/>
	<SolidColorBrush x:Key="TextBoxMouseOverColor" Color="#3B82F6" />
	<SolidColorBrush x:Key="TextBoxFocusedColor" Color="#2563EB" />
	<SolidColorBrush x:Key="TextBoxDisabledColor" Color="#F9FAFB" />
	<SolidColorBrush x:Key="TextBoxDisabledTextColor" Color="#6B7280" />

	<!-- Button Styles - More Appealing and Visible -->
	<SolidColorBrush x:Key="ButtonBaseColor" Color="#3B82F6" />
	<SolidColorBrush x:Key="ButtonMouseOverColor" Color="#2563EB" />
	<SolidColorBrush x:Key="ButtonPressedColor" Color="#1D4ED8" />
	<SolidColorBrush x:Key="ButtonDisabledColor" Color="#E5E7EB" />
	<SolidColorBrush x:Key="ButtonDisabledTextColor" Color="#9CA3AF" />

	<!-- ListView Styles - Better Contrast -->
	<SolidColorBrush x:Key="ListViewBaseColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="ListViewTextColor" Color="#1F2937" />
	<SolidColorBrush x:Key="ListViewItemMouseOverColor" Color="#F3F4F6" />
	<SolidColorBrush x:Key="ListViewItemBaseColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="ListViewItemSelectedColor" Color="#DBEAFE" />
	<SolidColorBrush x:Key="ListViewItemSelectedTextColor" Color="#1F2937" />

	<!-- ComboBox Styles - Enhanced Visibility -->
	<SolidColorBrush x:Key="ComboBoxBaseColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="ComboBoxTextColor" Color="#1F2937" />
	<SolidColorBrush x:Key="ComboBoxItemMouseOverColor" Color="#F3F4F6" />
	<SolidColorBrush x:Key="ComboBoxItemBaseColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="ComboBoxItemSelectedColor" Color="#DBEAFE" />
	<SolidColorBrush x:Key="ComboBoxItemSelectedTextColor" Color="#1F2937" />

	<!-- Checkbox Styles - Better Visibility -->
	<SolidColorBrush x:Key="CheckboxBorderColor" Color="#6B7280" />
	<SolidColorBrush x:Key="CheckboxCheckedColor" Color="#3B82F6" />
	<SolidColorBrush x:Key="CheckboxBackgroundColor" Color="#FFFFFF" />
	<SolidColorBrush x:Key="CheckboxHoverBorderColor" Color="#3B82F6" />

	<!-- TabControl Styles - Modern Look -->
	<SolidColorBrush x:Key="TabControlBackground" Color="#F8FAFC" />
	<SolidColorBrush x:Key="TabControlForeground" Color="#1F2937" />
	<SolidColorBrush x:Key="TabControlBorderColor" Color="#E5E7EB" />

	<!-- TabItem Styles - Enhanced Contrast -->
	<SolidColorBrush x:Key="TabItemBackground" Color="#F1F5F9" />
	<SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FFFFFF" />
	<SolidColorBrush x:Key="TabItemHoverBackground" Color="#E2E8F0" />
	<SolidColorBrush x:Key="TabItemBorderColor" Color="#CBD5E1" />
	<SolidColorBrush x:Key="TabItemSelectedBorderColor" Color="#3B82F6" />
	<SolidColorBrush x:Key="TabItemForeground" Color="#334155" />
	<SolidColorBrush x:Key="TabItemHoverForeground" Color="#1E293B" />
	<SolidColorBrush x:Key="TabItemDisabledForeground" Color="#94A3B8" />

	<!-- TabItem Colors -->
	<SolidColorBrush x:Key="MenuButtonStyleForeground" Color="{StaticResource FontColor}"/>
	<SolidColorBrush x:Key="MenuButtonStyleCheckedBackgroundBrush" Color="#E0E7FF"/>

	<!-- Define Brushes for ComboBox - Improved Visibility -->
	<SolidColorBrush x:Key="ComboBoxToggleButtonBackgroundBrush" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="ComboBoxToggleButtonBorderBrush" Color="#D1D5DB"/>
	<SolidColorBrush x:Key="ComboBoxArrowFillBrush" Color="#6B7280"/>
	<SolidColorBrush x:Key="ComboBoxArrowHoverFillBrush" Color="#3B82F6"/>
	<SolidColorBrush x:Key="ComboBoxArrowPressedFillBrush" Color="#2563EB"/>
	<SolidColorBrush x:Key="ComboBoxTextBoxBackgroundBrush" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="ComboBoxTextBoxForegroundBrush" Color="#1F2937"/>
	<SolidColorBrush x:Key="DropDownBorderBrush" Color="#D1D5DB"/>
	<SolidColorBrush x:Key="DropDownBackgroundBrush" Color="#FFFFFF"/>
	<SolidColorBrush x:Key="ComboBoxItemHighlightBackgroundBrush" Color="#F3F4F6"/>
	<SolidColorBrush x:Key="ComboBoxItemDisabledForegroundBrush" Color="#9CA3AF"/>

	<!-- Additional Modern Colors -->
	<SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
	<SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
	<SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
	<SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
	<SolidColorBrush x:Key="ErrorColor" Color="#EF4444"/>

	<!-- ListView Item Text Color -->
	<SolidColorBrush x:Key="ListViewItemTextColor" Color="{StaticResource ListViewTextColor}"/>

</ResourceDictionary>
